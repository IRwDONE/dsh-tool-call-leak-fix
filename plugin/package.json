{
  "name": "@irwdone/dsh-structured-output-guard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Detects tool-call argument boundary loss in assistant output, denies damaged calls, and self-heals within the same turn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IRwDONE/dsh-structured-output-guard.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/IRwDONE/dsh-structured-output-guard#readme",
  "bugs": {
    "url": "https://github.com/IRwDONE/dsh-structured-output-guard/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tool-calling",
    "structured-output",
    "llm-agent"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/detect.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
